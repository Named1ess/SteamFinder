# demo uses fictional data and never calls Steam. Set live AND provide your key for real data.
STEAM_MODE=demo
STEAM_API_KEY=
WEB_PORT=8080
BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=steamfinder
# Minimum spacing between live API calls; throttling still depends on Steam responses.
STEAM_REQUEST_DELAY_MS=350
DAILY_REQUEST_LIMIT=90000
