# live parses public Steam Community webpages without a key or login.
# Set demo explicitly for fictional offline data and integration verification.
STEAM_MODE=live
WEB_PORT=8080
BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=steamfinder
# Minimum spacing between public webpage requests; Steam may impose further limits.
STEAM_REQUEST_DELAY_MS=2000
DAILY_REQUEST_LIMIT=10000
